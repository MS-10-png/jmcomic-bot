# 配置模板：复制为 .env 后按需修改。
# 敏感密钥（DEEPSEEK_API_KEY / PIXIV_COOKIE / PIXIV_PHPSESSID）请放进 .env.local，不要写在这里。

# 驱动配置
DRIVER=~fastapi+~websockets
PORT=8081

# QQ机器人配置
QQ_BOT_ACCOUNT=100000000
QQ_BOT_PASSWORD=

# Pixiv 自动推送配置
PIXIV_DAILY_TIME=09:00
PIXIV_DAILY_COUNT=5
PIXIV_RANDOM_POOL_SIZE=80
PIXIV_RANDOM_RANKING_MODES=daily,weekly,monthly,rookie,original,male,female
PIXIV_RANDOM_RANKING_PAGES=3
JM_RANDOM_POOL_SIZE=80

# 缓存清理：自动删除超过 N 天未使用的 qq/pixiv 临时缓存（plugins/download 下），
# 不删除 downloads 里的手动下载。0 = 关闭自动清理，默认 30 天。
JM_CACHE_MAX_AGE_DAYS=30

# 封面预览：搜索/随机推荐时附带几张封面图（0 = 只发文字），默认推荐 5 张、搜索 3 张
JM_RECOMMEND_SEND_COVERS=5
JM_SEARCH_SEND_COVERS=3

# DeepSeek AI 对话：所有 @机器人 的消息先由 AI 理解意图再执行/回复。
# 留空 = 关闭 AI，机器人回退到原有规则解析。
# 密钥请填在 .env.local（不纳入版本控制），不要明文写在这里。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=600
DEEPSEEK_TIMEOUT=45
# 每个会话保留的最近聊天记录条数（0 = 不保留记忆）
LLM_HISTORY_MAX=12

# 群聊自主聊天：看上下文偶尔接话（只闲聊，绝不触发功能/发图）
# 1 = 开启，0 = 关闭
JM_AUTO_CHAT=1
# 每条消息接话概率（0-1），提到小鱼/机器人名字时必然接话
JM_AUTO_CHAT_PROBABILITY=0.3
# 同群两次自主接话最小间隔（秒）
JM_AUTO_CHAT_MIN_INTERVAL=180
# 同群每小时最多自主接话次数
JM_AUTO_CHAT_MAX_PER_HOUR=8
# 少于这个字数的消息不接话
JM_AUTO_CHAT_MIN_LENGTH=4
# 被说「闭嘴」后安静多久（秒）
JM_SILENCE_SECONDS=600

# 自启动聊天判断（chat_judge）：LLM 结合群聊上下文判断"用户是否在和 bot 聊天"，
# 是才以小鱼口吻接话，不是就安静。1 = 开启（开启后旧的概率接话自动退位），0 = 关闭
JM_CHAT_JUDGE=1
# 同群两次 LLM 判断的最小间隔（秒）；提到小鱼/机器人名字时不受此限，必然判断
JM_CHAT_JUDGE_MIN_INTERVAL=30
# 同群每小时最多自主接话次数
JM_CHAT_JUDGE_MAX_PER_HOUR=10
# 发完消息着重检测下一句：小鱼刚发过话后这个秒数内，用户下一句视为回复 bot，
# 跳过冷却强制判断（默认 90 秒）
JM_CHAT_JUDGE_FOLLOWUP_SECONDS=90

# 更新公告：每次机器人上线时在群里发公告，内容读项目根目录 UPDATE_NOTE.txt
# 1 = 开启，0 = 关闭
JM_ANNOUNCE_ON_START=1
# 同一个群两次公告的最小间隔（分钟），防止反复重启刷屏
JM_ANNOUNCE_COOLDOWN_MINUTES=30

# 逐页发送时的每张图片间隔秒数，0 = 不等待（默认 1）
# JM_SEND_DELAY_SECONDS=1

# @机器人 发数字时默认发送的图片张数，all/全部/0 = 不限（默认 10）
# JM_SEND_IMAGE_LIMIT=10

# Optional: Pixiv login cookie for R18/R18G image URLs.
# 只填其中一个即可；获取方法见项目根目录《Pixiv登录Cookie获取教程.md》。
# 填好后重启 NoneBot，再发「pixiv登录状态」验证是否生效。
PIXIV_COOKIE=
PIXIV_PHPSESSID=
